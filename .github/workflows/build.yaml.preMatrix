name: Build Packages

on:
  workflow_dispatch:
  push:
    branches:
      - "main"
    paths:
      - "srcpkgs/**"

permissions:
  contents: write
  packages: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # ---------------------------------------------------------------------------
  # 1. Detect which templates changed (keeps builds incremental: a discord bump
  #    must NOT rebuild the kernels). workflow_dispatch builds everything.
  # ---------------------------------------------------------------------------
  detect:
    name: Detect changed packages
    runs-on: ubuntu-latest
    outputs:
      changed: ${{ steps.d.outputs.changed }}
      any: ${{ steps.d.outputs.any }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 2
      - id: d
        shell: bash
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            changed="ananicy-cpp brave-origin cachyos-settings-runit discord faugus-launcher helium-browser heroic-games-launcher nlohmann-json spotify tutanota-desktop linux-cachyos linux-cachyos-v3 linux-cachyos-nvidia-open linux-cachyos-v3-nvidia-open nvidia"
          else
            changed="$(git diff --name-only HEAD^ HEAD -- srcpkgs/ | cut -d/ -f2 | sort -u | tr '\n' ' ')"
          fi
          # keep only names that still have a template on disk
          keep=""
          for p in $changed; do
            [ -f "srcpkgs/$p/template" ] && keep="$keep $p"
          done
          keep="${keep# }"
          echo "changed=$keep" >> "$GITHUB_OUTPUT"
          [ -n "$keep" ] && echo "any=yes" >> "$GITHUB_OUTPUT" || echo "any=no" >> "$GITHUB_OUTPUT"
          echo "changed: [$keep]"

  # ---------------------------------------------------------------------------
  # 2. Build, in parallel legs. Each leg owns one runner (own 6h budget, own
  #    disk). Kernel + its nvidia-open module share a leg so the module builds
  #    against the freshly-built kernel in the same hostdir (no artifact
  #    juggling). Each leg only builds the intersection of its bucket with the
  #    changed set, and uploads raw (unsigned) .xbps as a per-leg artifact.
  # ---------------------------------------------------------------------------
  build:
    name: Build ${{ matrix.name }}
    needs: detect
    if: needs.detect.outputs.any == 'yes'
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - name: kernel-cachyos
            packages: "linux-cachyos linux-cachyos-nvidia-open"
          - name: kernel-cachyos-v3
            packages: "linux-cachyos-v3 linux-cachyos-v3-nvidia-open"
          - name: nvidia
            packages: "nvidia"
          - name: apps
            packages: "ananicy-cpp brave-origin cachyos-settings-runit discord faugus-launcher helium-browser heroic-games-launcher nlohmann-json spotify tutanota-desktop"
    container:
      image: ghcr.io/void-linux/void-glibc-full:latest
      options: --platform linux/amd64 --privileged
      volumes:
        - /dev:/dev
      env:
        ARCH: "x86_64"
        BOOTSTRAP: "x86_64"
        TEST: 1
    steps:
      - name: Compute packages for this leg
        id: sel
        shell: bash
        run: |
          CHANGED="${{ needs.detect.outputs.changed }}"
          TO_BUILD=""
          for p in ${{ matrix.packages }}; do
            case " $CHANGED " in *" $p "*) TO_BUILD="$TO_BUILD $p";; esac
          done
          TO_BUILD="${TO_BUILD# }"
          echo "to_build=$TO_BUILD" >> "$GITHUB_OUTPUT"
          if [ -z "$TO_BUILD" ]; then
            echo "Nothing changed in leg '${{ matrix.name }}'. Skipping."
          else
            echo "Leg '${{ matrix.name }}' will build: $TO_BUILD"
          fi

      - name: Prepare container
        if: steps.sel.outputs.to_build != ''
        run: |
          mkdir -p /etc/xbps.d && cp /usr/share/xbps.d/*-repository-*.conf /etc/xbps.d/
          sed -i 's|repo-default|repo-ci|g' /etc/xbps.d/*-repository-*.conf
          xbps-install -Syu xbps && xbps-install -yu
          xbps-install -y sudo bash curl git github-cli ripgrep
          useradd -G xbuilder -M builder

      - name: Clone and checkout
        if: steps.sel.outputs.to_build != ''
        run: git clone --depth=1 --branch=master https://github.com/void-linux/void-packages

      - name: Checkout custom packages
        if: steps.sel.outputs.to_build != ''
        run: git clone --depth=1 --branch=main https://github.com/${{ github.repository }} custom-packages

      - name: Merge custom repositories
        if: steps.sel.outputs.to_build != ''
        run: |
          cp -f custom-packages/common/travis/changed_templates.sh \
            void-packages/common/travis/changed_templates.sh
          cat custom-packages/common/shlibs | tee -a \
            void-packages/common/shlibs
          for source in custom-packages/srcpkgs/*; do package=$(basename "$source"); rm -rf "void-packages/srcpkgs/$package"; cp -a "$source" "void-packages/srcpkgs/$package"; done

      - name: Prepare masterdir
        if: steps.sel.outputs.to_build != ''
        run: |
          cd void-packages
          chown -R builder:builder . &&
          sudo -Eu builder common/travis/set_mirror.sh &&
          sudo -Eu builder common/travis/prepare.sh &&
          common/travis/fetch-xtools.sh

      - name: Free disk space
        if: steps.sel.outputs.to_build != ''
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
            /opt/hostedtoolcache/CodeQL /usr/local/share/boost || true
          sudo docker image prune --all --force 2>/dev/null || true
          df -h /

      - name: Build packages
        if: steps.sel.outputs.to_build != ''
        shell: bash
        run: |
          mkdir -p ~/packages ~/hostdir
          chown -R builder:builder ~/packages ~/hostdir
          cd void-packages
          for pkg in ${{ steps.sel.outputs.to_build }}; do
            sudo -Eu builder ./xbps-src -j"$(nproc)" -s -H ~/hostdir pkg "$pkg"
          done
          if [ -d ~/hostdir/binpkgs ]; then
            find ~/hostdir/binpkgs -type f -regex ".+[.]xbps" -exec cp -t ~/packages {} +
          else
            echo "No packages were built; skipping collection."
          fi
          ls -1 ~/packages/*.xbps 2>/dev/null || echo "(none)"

      - name: Upload leg artifact
        if: steps.sel.outputs.to_build != ''
        uses: actions/upload-artifact@v4
        with:
          name: pkgs-${{ matrix.name }}
          path: ~/packages/*.xbps
          if-no-files-found: ignore
          retention-days: 1

  # ---------------------------------------------------------------------------
  # 3. Collect every leg's packages, merge with the existing release, sign the
  #    complete set ONCE (single repodata), and prepare the release files.
  #    This is the only place signing happens — preserving the fixes:
  #      * self-contained (no untrusted remote repo → no [Y/n] hang)
  #      * upload the EXACT archives that were indexed + signed (gen-B)
  # ---------------------------------------------------------------------------
  sign-and-release:
    name: Sign and prepare release
    needs: [detect, build]
    if: needs.detect.outputs.any == 'yes'
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/void-linux/void-glibc-full:latest
      options: --platform linux/amd64 --privileged
      env:
        ARCH: "x86_64"
    steps:
      - name: Prepare container
        run: |
          xbps-install -Syu xbps && xbps-install -yu
          xbps-install -y bash curl git github-cli coreutils findutils

      - name: Download all leg artifacts
        uses: actions/download-artifact@v4
        with:
          pattern: pkgs-*
          path: /tmp/legs
          merge-multiple: true

      - name: Collect newly built packages
        shell: bash
        run: |
          mkdir -p ~/packages ~/new_packages
          shopt -s nullglob
          built=(/tmp/legs/*.xbps)
          if (( ${#built[@]} == 0 )); then
            echo "No packages were built by any leg; nothing to release."
            echo "HAVE_PKGS=no" >> "$GITHUB_ENV"
            exit 0
          fi
          cp "${built[@]}" ~/packages/
          cp "${built[@]}" ~/new_packages/
          echo "HAVE_PKGS=yes" >> "$GITHUB_ENV"
          echo "Newly built:"; ls -1 ~/packages

      - name: Download existing repository packages
        if: env.HAVE_PKGS == 'yes'
        shell: bash
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p ~/all_packages
          gh release download latest \
            --repo "$GITHUB_REPOSITORY" \
            --dir ~/all_packages || echo "No existing latest release; creating from this build"

      - name: Merge packages
        if: env.HAVE_PKGS == 'yes'
        shell: bash
        run: |
          rm -f ~/all_packages/*.sig2 ~/all_packages/x86_64-repodata 2>/dev/null || true
          # drop old versions of anything we just rebuilt
          for pkg in $(ls -1 ~/packages/*.xbps | sed 's/-[^-]*$//'); do
            rm -f ~/all_packages/"$(basename "$pkg")"*.xbps
          done
          shopt -s nullglob
          existing=(~/all_packages/*.xbps)
          if (( ${#existing[@]} )); then
            cp "${existing[@]}" ~/packages/
          fi
          echo "Full set to index/sign:"; ls -1 ~/packages/*.xbps | wc -l

      - name: Sign and package
        if: env.HAVE_PKGS == 'yes'
        env:
          PRIVATE_PEM: ${{ secrets.PRIVATE_PEM }}
          PRIVATE_PEM_PASSPHRASE: ${{ secrets.PRIVATE_PEM_PASSPHRASE }}
        run: |
          cd ~/packages
          xbps-rindex -a *
          temp_key=$(mktemp)
          echo "$PRIVATE_PEM" > "$temp_key"
          export XBPS_PASSPHRASE=$PRIVATE_PEM_PASSPHRASE
          chmod 600 "$temp_key"
          xbps-rindex --privkey "$temp_key" --sign --signedby "void-packages-github-actions" ~/packages
          xbps-rindex --privkey "$temp_key" --sign-pkg ~/packages/*.xbps
          rm -f "$temp_key"

      - name: Prepare release files
        if: env.HAVE_PKGS == 'yes'
        shell: bash
        run: |
          mkdir ~/release
          cp ~/packages/x86_64-repodata ~/release/
          # upload the EXACT archives that were indexed + signed, plus their sigs
          for f in ~/packages/*.xbps; do
            cp "$f" "$f.sig2" ~/release/
          done

      - name: Delete existing release assets
        if: env.HAVE_PKGS == 'yes'
        shell: bash
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          for pkg in $(ls -1 ~/new_packages/*.xbps | sed 's/-[^-]*$//' | xargs -I {} basename {}); do
            gh release view latest --repo "$GITHUB_REPOSITORY" --json assets --jq '.assets[].name' \
            | grep "^${pkg}-" | xargs -I {} gh release delete-asset latest {} --repo "$GITHUB_REPOSITORY" --yes || true
          done
          gh release delete-asset latest "x86_64-repodata" --repo "$GITHUB_REPOSITORY" --yes || true

      - name: Upload release artifact
        if: env.HAVE_PKGS == 'yes'
        uses: actions/upload-artifact@v4
        with:
          name: built-packages
          path: ~/release/
          retention-days: 1

  # ---------------------------------------------------------------------------
  # 4. Publish the collected + signed set to the 'latest' release.
  # ---------------------------------------------------------------------------
  create-github-release:
    needs: sign-and-release
    runs-on: ubuntu-latest
    steps:
      - name: Download built packages
        uses: actions/download-artifact@v4
        with:
          name: built-packages
          path: ~/release/

      - name: Create Release
        uses: softprops/action-gh-release@v1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          files: /home/runner/release/*
          tag_name: latest
          name: Latest Build
          body: |
            Latest build of XBPS packages
            Built on: ${{ github.event.repository.updated_at }}
          prerelease: false
